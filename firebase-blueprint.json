{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and AI preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "Note": {
      "title": "Note",
      "description": "Voice and AI generated notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "content"]
    },
    "SavedLocation": {
      "title": "SavedLocation",
      "description": "User saved locations and map telemetry points",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "label": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "address": { "type": "string" }
      },
      "required": ["id", "userId", "lat", "lng"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "User conversation session and message logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "messages": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt", "messages"]
    },
    "WorkspaceConfig": {
      "title": "WorkspaceConfig",
      "description": "User OS workspace layout, active module state, and preferences",
      "type": "object",
      "properties": {
        "activeTab": { "type": "string" },
        "activeWorkspaceService": { "type": "string" },
        "activeModules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "themeMode": { "type": "string", "enum": ["system", "dark", "light"] },
        "accentColor": { "type": "string" },
        "telemetryTimeRange": { "type": "string" },
        "isMinimalHud": { "type": "boolean" },
        "isGpuBoosted": { "type": "boolean" },
        "visionMode": { "type": "string" },
        "lastActiveTimestamp": { "type": "number" },
        "pinnedServices": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user document"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Notes created by a user"
    },
    "/users/{userId}/savedLocations/{locationId}": {
      "schema": "SavedLocation",
      "description": "Saved map coordinates for a user"
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Chat and conversation sessions for a user"
    },
    "/users/{userId}/workspaceConfig/{configId}": {
      "schema": "WorkspaceConfig",
      "description": "User OS workspace layout and active module state"
    }
  }
}
